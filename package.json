{
  "name": "juris-flow",
  "version": "0.1.0",
  "private": true,
  "description": "O software jurídico brasileiro que entende do Direito.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run db:generate && npm run build --workspaces --if-present",
    "postinstall": "npm run db:generate",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "db:generate": "npm run prisma:generate --workspace=packages/db",
    "db:push": "npm run prisma:push --workspace=packages/db",
    "db:migrate": "npm run prisma:migrate --workspace=packages/db",
    "db:studio": "npm run prisma:studio --workspace=packages/db",
    "db:seed": "npm run seed --workspace=packages/db"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "[email protected]",
  "dependencies": {
    "resend": "^6.18.0"
  }
}
